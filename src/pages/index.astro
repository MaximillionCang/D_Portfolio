---
import BaseLayout from '../layouts/BaseLayout.astro';
import { categories, projects } from '../data/projects';
import portrait from '../assets/portrait.webp';
import mascot from '../assets/mascot.webp';
import pin from '../assets/pin.webp';
import laptopFriend from '../assets/laptop-friend.webp';

const featured = projects.find((project) => project.featured)!;
const remaining = projects.filter((project) => !project.featured);
---

<BaseLayout>
  <section class="hero-shell" aria-labelledby="hero-title">
    <div class="stripe stripe-top" aria-hidden="true"></div>
    <div class="hero-panel">
      <div class="hero-meta"><span>THE WORK OF DARREN RYUSA</span><span>PORTFOLIO / 2026</span></div>
      <div class="hero-art">
        <div class="photo-paper">
          <img src={portrait.src} width={portrait.width} height={portrait.height} alt="Portrait of Darren Ryusa" fetchpriority="high" />
          <span>hey, i'm darren!</span>
        </div>
        <img class="hero-pin" src={pin.src} width={pin.width} height={pin.height} alt="" aria-hidden="true" />
        <img class="hero-mascot" src={mascot.src} width={mascot.width} height={mascot.height} alt="" aria-hidden="true" />
        <span class="hero-doodle" aria-hidden="true">✳</span>
      </div>
      <div class="hero-copy">
        <div class="hero-kicker"><span class="kicker-line"></span> MARKETING · SOCIAL MEDIA · GRAPHIC DESIGNER</div>
        <h1 id="hero-title"><span>Creative</span><span>Portfolio<span class="title-spark" aria-hidden="true">✴</span></span></h1>
        <div class="hero-byline"><span>by Darren Ryusa</span></div>
        <p>A collection of work, ideas and things made along the way.</p>
        <a class="round-link" href="#work"><span>Explore<br />my work</span><span aria-hidden="true">↘</span></a>
      </div>
      <div class="hero-bottom"><span>EST. WITH CURIOSITY</span><span>SCROLL TO EXPLORE ↓</span></div>
    </div>
    <div class="stripe stripe-bottom" aria-hidden="true"></div>
  </section>

  <div class="marquee-bleed" aria-label="Marketing, social media and graphic design">
    <div class="marquee">
      <div class="marquee-track" aria-hidden="true">
        {[0, 1].map(() => (
          <div class="marquee-group">
            {Array.from({ length: 6 }, () => ['MARKETING', 'SOCIAL MEDIA', 'GRAPHIC DESIGN']).flat().map((label) => <><span>{label}</span><b>✳</b></>)}
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="about-band">
  <section class="about-section section-wrap" id="about" aria-labelledby="about-title">
    <div class="section-index"><span>01 / A LITTLE INTRODUCTION</span><span class="index-stroke"></span></div>
    <div class="about-content">
      <div class="about-heading"><span class="tiny-star" aria-hidden="true">✳</span><h2 id="about-title">Hello there,<br /><em>I'm Darren.</em></h2></div>
      <div class="about-body">
        <p>I work across <strong>marketing, social media and graphic design.</strong> Here you’ll find a selection of visual projects, from illustrated objects to print and digital content.</p>
        <a class="text-link" href="#work">Come see what I’ve made <span aria-hidden="true">↗</span></a>
      </div>
      <div class="laptop-sticker"><img src={laptopFriend.src} width={laptopFriend.width} height={laptopFriend.height} alt="" aria-hidden="true" /><span>always making<br />something new</span></div>
    </div>
  </section>
  </div>

  <section class="work-section section-wrap" id="work" aria-labelledby="work-title">
    <div class="section-index"><span>02 / THE GOOD STUFF</span><span class="index-stroke"></span></div>
    <div class="work-heading">
      <div><span class="eyebrow">A little bit of everything</span><h2 id="work-title">Things I've<br /><em>created.</em></h2></div>
      <p>Different ideas, different formats. Browse the work and open a project to see more.</p>
    </div>
    <div class="filters" role="group" aria-label="Filter projects">
      {categories.map((category, index) => (
        <button type="button" class="filter" data-filter={category} aria-pressed={index === 0 ? 'true' : 'false'}>
          <span>{category}</span><small>{category === 'All projects' ? projects.length.toString().padStart(2, '0') : projects.filter((project) => project.category === category).length.toString().padStart(2, '0')}</small>
        </button>
      ))}
    </div>

    <div class="work-grid" id="project-grid">
      <article class="project-card featured-card" data-category={featured.category}>
        <a class="feature-link" href={`/work/${featured.slug}/`} aria-label={`Explore ${featured.title}`}>
          <div class="featured-image"><span class="image-corner">FEATURED PROJECT ✳</span><img class="project-logo" src={featured.logo.src} width={featured.logo.width} height={featured.logo.height} alt={featured.logoAlt} loading="lazy" /></div>
          <div class="featured-info"><span class="project-number">{featured.index} / SELECTED WORK</span><h3>{featured.title}<span aria-hidden="true">↗</span></h3><p>{featured.summary}</p><div class="project-bottom"><span>{featured.label}</span><span class="view-project">View project →</span></div></div>
        </a>
      </article>
      {remaining.map((project) => (
        <article class={`project-card regular-card card-tone-${project.cardTone}`} data-category={project.category}>
          <a href={`/work/${project.slug}/`} aria-label={`Explore ${project.title}`}>
            <div class="card-image"><img class="project-logo" src={project.logo.src} width={project.logo.width} height={project.logo.height} alt={project.logoAlt} loading="lazy" /><span class="card-arrow" aria-hidden="true">↗</span></div>
            <div class="card-caption"><div><span class="project-number">{project.index} / {project.category}</span><h3>{project.title}</h3></div><span class="card-asterisk" aria-hidden="true">✳</span></div>
            <p>{project.summary}</p>
          </a>
        </article>
      ))}
    </div>
    <div class="empty-projects" id="empty-projects" hidden aria-live="polite">
      <span aria-hidden="true">✳</span><h3>More to come.</h3><p>This part of the portfolio is still growing. Take a look at the other projects for now.</p>
    </div>
  </section>

  <section class="note-section section-wrap" aria-label="A note from the portfolio">
    <div class="note-card"><span class="note-index">03 / A NOTE</span><p>From bookmarks to moving images, the work keeps <em>changing shape.</em></p><a href="mailto:greg.darrenryusa@gmail.com">Let's talk about yours <span aria-hidden="true">↗</span></a><span class="note-star" aria-hidden="true">✴</span></div>
  </section>

  <script>
    const filters = [...document.querySelectorAll<HTMLButtonElement>('.filter')];
    const cards = [...document.querySelectorAll<HTMLElement>('.project-card')];
    const grid = document.querySelector<HTMLElement>('#project-grid');
    const empty = document.querySelector<HTMLElement>('#empty-projects');

    filters.forEach((button) => {
      button.addEventListener('click', () => {
        const category = button.dataset.filter;
        filters.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
        let visible = 0;
        cards.forEach((card) => {
          const show = category === 'All projects' || card.dataset.category === category;
          card.hidden = !show;
          if (show) visible += 1;
        });
        if (grid) grid.classList.toggle('is-filtered', category !== 'All projects');
        if (empty) empty.hidden = visible !== 0;
      });
    });
  </script>
</BaseLayout>
