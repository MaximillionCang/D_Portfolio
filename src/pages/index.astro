---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Icon from '../components/Icon.astro';
import { categories, projects } from '../data/projects';
import { software } from '../data/skills';
import portrait from '../assets/portrait.webp';
import mascot from '../assets/mascot.webp';
import pin from '../assets/pin.webp';
import laptopFriend from '../assets/laptop-friend.webp';
const disciplines = [{ name: 'Marketing', icon: 'marketing' }, { name: 'Social Media', icon: 'social' }, { name: 'Graphic Design', icon: 'design' }];
---
<BaseLayout>
  <section class="hero section-wrap" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="hero-kicker">Marketing · Social Media · Graphic Design</p>
      <h1 id="hero-title">Creative<br />Portfolio<span class="hero-spark" aria-hidden="true">✴</span></h1>
      <span class="hero-byline">by Darren Ryusa</span>
      <p class="hero-description">Ideas made visual, from first sketch to final frame.</p>
      <a class="button button-primary" href="#work">View projects <Icon name="arrow" size={20} /></a>
    </div>
    <div class="hero-art">
      <div class="photo-paper"><img src={portrait.src} width={portrait.width} height={portrait.height} alt="Portrait of Darren Ryusa" fetchpriority="high" /><span>hey, i'm darren!</span></div>
      <img class="hero-pin" src={pin.src} width={pin.width} height={pin.height} alt="" aria-hidden="true" />
      <img class="hero-mascot" src={mascot.src} width={mascot.width} height={mascot.height} alt="" aria-hidden="true" />
    </div>
  </section>

  <div class="marquee-bleed"><div class="marquee" aria-label="Marketing, social media and graphic design">
    <div class="marquee-track" aria-hidden="true">{[0, 1].map(() => <div class="marquee-group">{Array.from({ length: 5 }, () => ['Marketing', 'Social media', 'Graphic design']).flat().map(label => <><span>{label}</span><b>✳</b></>)}</div>)}</div>
  </div></div>

  <section class="about-band" id="about" aria-labelledby="about-title"><div class="section-wrap">
    <div class="about-content">
      <div class="about-intro"><h2 id="about-title">Hello there,<br />I’m <em>Darren</em>.</h2><p>I’m a final-year Advertising student at Xiamen University Malaysia.</p><img class="laptop-friend" src={laptopFriend.src} width={laptopFriend.width} height={laptopFriend.height} alt="" aria-hidden="true" /></div>
      <div class="about-disciplines"><h3>What I do</h3><div class="disciplines">{disciplines.map(item => <div class="discipline"><span class="discipline-icon"><Icon name={item.icon} size={34} /></span><strong>{item.name}</strong></div>)}</div><a class="button button-secondary" href="#work">See my work <Icon name="arrow" size={19} /></a></div>
    </div>
    <div class="skills-section"><div class="skills-heading"><h3>Tools I work with</h3></div><div class="skills-list">{Object.entries(software).map(([key, item]) => <div class="skill-item"><div class="skill-orbit" style={`--score: ${item.rating * 10}%`} aria-hidden="true"><span>{item.mark}</span></div><strong>{item.name}</strong><span>{item.rating}/10</span><meter class="sr-only" min="0" max="10" value={item.rating} aria-label={`${item.name}, self-rated proficiency`}>{item.rating} out of 10</meter></div>)}</div></div>
  </div></section>

  <section class="work-section section-wrap" id="work" aria-labelledby="work-title">
    <div class="work-heading"><h2 id="work-title">Things I’ve <em>created.</em></h2><p>Branding, content, illustrations & moments.</p></div>
    <div class="filters" role="group" aria-label="Filter projects">{categories.map((category, index) => <button type="button" class="filter" data-filter={category} aria-pressed={index === 0 ? 'true' : 'false'}>{category}</button>)}</div>
    <p class="sr-only" id="filter-status" aria-live="polite">{projects.length} projects shown</p>
    <div class="work-grid" id="project-grid">{projects.map(project => <ProjectCard project={project} />)}</div>
    <div class="empty-projects" id="empty-projects" hidden><h3>More to come.</h3><p>This collection is still growing. Try another category.</p><button class="button button-secondary" type="button" id="show-all">Show all projects <Icon name="arrow" size={18} /></button></div>
  </section>

  <script>
    const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const cards = [...document.querySelectorAll<HTMLElement>('.project-card')];
    function filterProjects(category: string) {
      let count = 0;
      filters.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.filter === category)));
      cards.forEach(card => { card.hidden = category !== 'All projects' && card.dataset.category !== category; if (!card.hidden) count++; });
      document.querySelector('#project-grid')?.classList.toggle('is-filtered', category !== 'All projects');
      const empty = document.querySelector<HTMLElement>('#empty-projects');
      if (empty) empty.hidden = count !== 0;
      const status = document.querySelector('#filter-status');
      if (status) status.textContent = `${count} ${count === 1 ? 'project' : 'projects'} shown`;
    }
    filters.forEach(button => button.addEventListener('click', () => filterProjects(button.dataset.filter!)));
    document.querySelector('#show-all')?.addEventListener('click', () => filterProjects('All projects'));
  </script>
</BaseLayout>
