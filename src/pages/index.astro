---
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutSection from '../components/AboutSection.astro';
import ProjectRail from '../components/ProjectRail.astro';
import Icon from '../components/Icon.astro';
import portrait from '../assets/portrait.webp';
import mascot from '../assets/mascot.webp';
import pin from '../assets/pin.webp';
---
<BaseLayout>
  <section class="hero section-wrap" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="hero-kicker">Marketing · Social Media · Graphic Design</p>
      <h1 id="hero-title">Creative<br />Portfolio<span class="hero-spark" aria-hidden="true">✴</span></h1>
      <span class="hero-byline">by Darren Ryusa</span>
      <p class="hero-description">Ideas made visual, from first sketch to final frame.</p>
      <a class="button button-primary" href="#work">View projects <Icon name="arrow" size={20} /></a>
    </div>
    <div class="hero-art">
      <div class="photo-paper"><img src={portrait.src} width={portrait.width} height={portrait.height} alt="Portrait of Darren Ryusa" fetchpriority="high" /><span>hey, i'm darren!</span></div>
      <img class="hero-pin" src={pin.src} width={pin.width} height={pin.height} alt="" aria-hidden="true" />
      <img class="hero-mascot" src={mascot.src} width={mascot.width} height={mascot.height} alt="" aria-hidden="true" />
    </div>
  </section>

  <div class="marquee-bleed"><div class="marquee" aria-label="Marketing, social media and graphic design">
    <div class="marquee-track" aria-hidden="true">{[0, 1].map(() => <div class="marquee-group">{Array.from({ length: 5 }, () => ['Marketing', 'Social media', 'Graphic design']).flat().map(label => <><span>{label}</span><b>✳</b></>)}</div>)}</div>
  </div></div>

  <AboutSection />

  <ProjectRail />

</BaseLayout>
