---
import { software, type SoftwareKey } from '../data/skills';
type Props = { tools: SoftwareKey[] };
const { tools } = Astro.props;
---
<ul class="software-tools" aria-label="Software used">{tools.map(key => <li><span class="software-mark" aria-hidden="true">{software[key].mark}</span><span>{software[key].name}</span></li>)}</ul>
