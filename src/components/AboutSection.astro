---
import '../styles/about.css';
import Icon from './Icon.astro';
import { software } from '../data/skills';
import laptopFriend from '../assets/laptop-friend.webp';
const disciplines = [{ name: 'Marketing', icon: 'marketing' }, { name: 'Social Media', icon: 'social' }, { name: 'Graphic Design', icon: 'design' }];
---
<section class="about-band" id="about" aria-labelledby="about-title"><div class="section-wrap">
  <div class="about-content">
    <div class="about-intro"><h2 id="about-title">Hello there,<br />I’m <em>Darren</em>.</h2></div>
    <div class="about-note"><p class="about-bubble">I’m a final-year Advertising student at Xiamen University Malaysia.</p><img class="laptop-friend" src={laptopFriend.src} width={laptopFriend.width} height={laptopFriend.height} alt="" aria-hidden="true" loading="lazy" /></div>
  </div>
  <div class="about-disciplines">
    <div class="discipline-heading"><h3>What I do</h3><a class="button button-secondary" href="#work">See my work <Icon name="arrow" size={19} /></a></div>
    <div class="disciplines">{disciplines.map(item => <div class="discipline"><Icon name={item.icon} size={29} /><strong>{item.name}</strong></div>)}</div>
  </div>
  <div class="skills-section"><h3>Tools I work with</h3><div class="skills-list">{Object.values(software).map(item => <div class="skill-item"><img class="tool-logo" src={item.icon} width="56" height="56" alt="" aria-hidden="true" loading="lazy" /><strong>{item.name}</strong><span>{item.rating}/10</span><meter class="sr-only" min="0" max="10" value={item.rating} aria-label={`${item.name}, self-rated proficiency`}>{item.rating} out of 10</meter></div>)}</div></div>
</div></section>
