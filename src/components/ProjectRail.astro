---
import '../styles/project-rail.css';
import { categories, projects } from '../data/projects';
import ProjectCard from './ProjectCard.astro';
import Icon from './Icon.astro';
---
<section class="work-section section-wrap" id="work" aria-labelledby="work-title">
  <div class="work-heading"><h2 id="work-title">Things I’ve <em>created.</em></h2><p>Branding, content, illustrations & moments.</p></div>
  <div class="work-toolbar">
    <div class="filters" role="group" aria-label="Filter projects">{categories.map((category, index) => <button type="button" class="filter" data-filter={category} aria-pressed={index === 0 ? 'true' : 'false'}>{category}</button>)}</div>
    <div class="gallery-navigation" role="group" aria-label="Browse projects"><button class="gallery-arrow" type="button" data-direction="previous" aria-label="Previous projects" aria-controls="project-grid" disabled><Icon name="previous" size={23} /></button><button class="gallery-arrow" type="button" data-direction="next" aria-label="Next projects" aria-controls="project-grid"><Icon name="next" size={23} /></button></div>
  </div>
  <p class="sr-only" id="filter-status" aria-live="polite">{projects.length} projects shown</p>
  <div class="studio-rail"><div class="work-track" id="project-grid" role="region" aria-roledescription="carousel" aria-label="Project display, use the arrow buttons or swipe to browse" tabindex="0">{projects.map((project, index) => <ProjectCard project={project} index={index} />)}</div></div>
  <div class="empty-projects" id="empty-projects" hidden><h3>More to come.</h3><p>This collection is still growing. Try another category.</p><button class="button button-secondary" type="button" id="show-all">Show all projects <Icon name="arrow" size={18} /></button></div>
</section>
<script>
  const track = document.querySelector<HTMLElement>('.work-track');
  const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const cards = [...document.querySelectorAll<HTMLElement>('.project-card')];
  const previous = document.querySelector<HTMLButtonElement>('[data-direction="previous"]');
  const next = document.querySelector<HTMLButtonElement>('[data-direction="next"]');
  const visibleCards = () => cards.filter(card => !card.hidden);
  function updateControls() {
    if (!track || !previous || !next) return;
    previous.disabled = track.scrollLeft < 2;
    next.disabled = track.scrollLeft >= track.scrollWidth - track.clientWidth - 2;
  }
  function move(direction: number, end?: boolean) {
    if (!track) return;
    const visible = visibleCards();
    if (!visible.length) return;
    const trackBounds = track.getBoundingClientRect();
    const padding = parseFloat(getComputedStyle(track).paddingLeft);
    const positions = visible.map(card => card.getBoundingClientRect().left - trackBounds.left + track.scrollLeft - padding);
    let index = positions.reduce((best, position, current) => Math.abs(position - track.scrollLeft) < Math.abs(positions[best] - track.scrollLeft) ? current : best, 0);
    index = end ? (direction > 0 ? visible.length - 1 : 0) : Math.max(0, Math.min(visible.length - 1, index + direction));
    track.scrollTo({ left: positions[index], behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
  }
  function filterProjects(category: string) {
    let count = 0;
    filters.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.filter === category)));
    cards.forEach(card => { card.hidden = category !== 'All projects' && card.dataset.category !== category; if (!card.hidden) count++; });
    const empty = document.querySelector<HTMLElement>('#empty-projects');
    if (empty) empty.hidden = count !== 0;
    const status = document.querySelector('#filter-status');
    if (status) status.textContent = `${count} ${count === 1 ? 'project' : 'projects'} shown`;
    track?.scrollTo({ left: 0, behavior: 'instant' });
    requestAnimationFrame(updateControls);
  }
  filters.forEach(button => button.addEventListener('click', () => filterProjects(button.dataset.filter!)));
  document.querySelector('#show-all')?.addEventListener('click', () => filterProjects('All projects'));
  previous?.addEventListener('click', () => move(-1));
  next?.addEventListener('click', () => move(1));
  track?.addEventListener('scroll', updateControls, { passive: true });
  track?.addEventListener('keydown', event => {
    if (event.target !== track) return;
    if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') { event.preventDefault(); move(event.key === 'ArrowRight' ? 1 : -1); }
    if (event.key === 'Home' || event.key === 'End') { event.preventDefault(); move(event.key === 'End' ? 1 : -1, true); }
  });
  if (track) new ResizeObserver(updateControls).observe(track);
  updateControls();
</script>
