  {name === 'linkedin' ? <><rect x="2" y="2" width="20" height="20" rx="3" fill="currentColor" stroke="none" /><path d="M6 10h3v8H6zM6 6h3v3H6zm5 4h3v1c.5-.8 1.4-1.3 2.5-1.3 2 0 3.5 1.2 3.5 4V18h-3v-4c0-1.1-.4-1.7-1.3-1.7s-1.7.6-1.7 1.8V18h-3z" fill="var(--icon-inverse, #4d2a0a)" stroke="none" /></> : name === 'instagram' ? <><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r=".7" fill="currentColor" /></> : paths[name]?.map(d => <path d={d} />)}
