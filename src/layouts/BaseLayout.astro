---
import '../styles/global.css';
import Icon from '../components/Icon.astro';

type Props = {
  title?: string;
  description?: string;
};

const {
  title = 'Darren Ryusa | Creative Portfolio',
  description = 'Selected graphic design, social media content and visual work by Darren Ryusa.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f5f9" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header" id="top">
      <a class="brand" href="/" aria-label="Darren Ryusa, home"><span class="brand-star" aria-hidden="true">✳</span><span>Darren Ryusa</span></a>
      <nav class="site-nav" aria-label="Main navigation">
        <a href="/#about">About</a>
        <a href="/#work">Work</a>
        <a class="nav-contact" href="/#contact">Contact <Icon name="email" size={17} /></a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer" id="contact">
      <div class="footer-main">
        <div>
          <h2>Let’s <em>talk.</em></h2>
          <p>Have a project in mind? I’d love to hear about it.</p>
        </div>
        <div class="footer-contacts">
          <div class="contact-detail"><Icon name="email" size={27} /><div class="contact-copy"><strong>Email</strong><p class="contact-value">greg.darrenryusa@gmail.com</p></div></div>
          <div class="contact-detail"><Icon name="phone" size={27} /><div class="contact-copy"><strong>Phone / WhatsApp</strong><p class="contact-value contact-phone-value"><span>0177340593</span><Icon name="whatsapp" size={22} /></p></div></div>
          <a class="footer-linkedin" href="https://www.linkedin.com/in/darren-ryusa-31659b30b/" target="_blank" rel="noopener noreferrer" aria-label="View Darren Ryusa on LinkedIn (opens in a new tab)"><Icon name="linkedin" size={23} /><span>LinkedIn</span><Icon name="external" size={18} /></a>
        </div>
      </div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} Darren Ryusa</span><a class="footer-top-link" href="#top">Back to top <Icon name="down" size={17} /></a></div>
    </footer>
  </body>
</html>
